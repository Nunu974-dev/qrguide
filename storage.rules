rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Règles pour les photos de logements
    match /logements/{userId}/{fileName} {
      // Lecture publique pour afficher les images dans les guides
      allow read: if true;
      
      // Écriture uniquement pour l'utilisateur authentifié propriétaire
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Règles pour les avatars des hôtes
    match /avatars/{userId}/{fileName} {
      // Lecture publique pour afficher les avatars dans les guides
      allow read: if true;
      
      // Écriture uniquement pour l'utilisateur authentifié propriétaire
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Règles pour les autres fichiers (QR codes, etc.)
    match /{allPaths=**} {
      // Lecture publique
      allow read: if true;
      
      // Écriture uniquement pour les utilisateurs authentifiés
      allow write: if request.auth != null;
    }
  }
}
